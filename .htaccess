Options -MultiViews
RewriteEngine On

# 1. Externally redirect any request ending in .html to the extensionless URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Internally rewrite the extensionless URL back to the .html file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]